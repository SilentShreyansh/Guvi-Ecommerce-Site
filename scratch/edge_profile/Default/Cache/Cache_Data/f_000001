<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SHOP.CO — Find Clothes That Matches Your Style</title>
  <meta name="description" content="Shop the latest trends in casual wear, formal attire, jackets, and campus lifestyle essentials. High-quality fashion inspired by international standards.">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- 1. ANNOUNCEMENT BAR -->
  <div class="announcement-bar" id="announcementBar">
    <div class="announcement-container">
      <div class="announcement-text">
        <span>Sign up and get 20% off your first order.</span>
        <a href="#catalogSection" class="announcement-link" onclick="applyCouponCode('GUVI20')">Sign Up Now</a>
      </div>
      <div class="announcement-tools">
        <div class="role-switcher-pill">
          <span>Role:</span>
          <select id="headerRoleSwitcher" onchange="handleRoleSwitch(this.value)">
            <option value="BUYER">Buyer (Rahul Sharma)</option>
            <option value="SELLER">Seller (Campus Style)</option>
            <option value="ADMIN">Admin (System Admin)</option>
          </select>
        </div>
        <a href="dashboard.html" style="color:#d1d5db; font-size:12px; font-weight:600; text-decoration:none;">Dashboard &rarr;</a>
        <button type="button" class="btn-announcement-close" onclick="closeAnnouncementBar()" aria-label="Close Announcement">&times;</button>
      </div>
    </div>
  </div>

  <!-- 2. NAVIGATION HEADER (SHOP.CO Style) -->
  <header class="site-header" id="siteHeader">
    <div class="container header-inner">
      
      <!-- Brand Logo -->
      <a href="index.html" class="brand-logo" id="brandLogo">
        <span class="brand-text">SHOP.CO</span>
        <span class="brand-tag">CAMPUS</span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="desktop-nav" aria-label="Primary Navigation">
        <div class="nav-dropdown-wrapper">
          <div class="nav-link">
            <span>Shop</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <div class="nav-dropdown-menu">
            <a href="javascript:void(0)" class="dropdown-item" onclick="filterByCategory(0)">All Products <span>&rarr;</span></a>
            <a href="javascript:void(0)" class="dropdown-item" onclick="filterByCategory(6)">Casual Wear <span>&rarr;</span></a>
            <a href="javascript:void(0)" class="dropdown-item" onclick="filterByCategory(7)">Formal & Evening <span>&rarr;</span></a>
            <a href="javascript:void(0)" class="dropdown-item" onclick="filterByCategory(8)">Outerwear & Coats <span>&rarr;</span></a>
            <a href="javascript:void(0)" class="dropdown-item" onclick="filterByCategory(1)">Tech Peripherals <span>&rarr;</span></a>
            <a href="javascript:void(0)" class="dropdown-item" onclick="filterByCategory(2)">Audio Gear <span>&rarr;</span></a>
            <a href="javascript:void(0)" class="dropdown-item" onclick="filterByCategory(3)">Textbooks & Books <span>&rarr;</span></a>
          </div>
        </div>
        <a href="#newArrivalsSection" class="nav-link">New Arrivals</a>
        <a href="#topSellingSection" class="nav-link">Top Selling</a>
        <a href="#dressStyleSection" class="nav-link">Styles</a>
        <a href="#catalogSection" class="nav-link">On Sale</a>
      </nav>

      <!-- Pill Search Bar -->
      <div class="header-search-bar">
        <svg class="search-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" class="search-input-pill" placeholder="Search for products..." autocomplete="off" oninput="handleSearchInput(this.value)">
      </div>

      <!-- Action Icons -->
      <div class="header-actions">
        <!-- Delivery Route Tracking -->
        <button type="button" class="header-icon-btn" onclick="openRouteModal()" title="Track Delivery Route" aria-label="Track Route">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </button>

        <!-- Wishlist -->
        <button type="button" class="header-icon-btn" onclick="toggleWishlistDrawer(true)" title="Wishlist" aria-label="Wishlist">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="header-icon-badge" id="wishlistCountBadge">0</span>
        </button>

        <!-- Shopping Cart -->
        <button type="button" class="header-icon-btn" id="cartHeaderBtn" onclick="toggleCartDrawer(true)" title="Shopping Cart" aria-label="Cart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="header-icon-badge" id="cartCountBadge">0</span>
        </button>

        <!-- Profile / Dashboard Dropdown -->
        <a href="dashboard.html" class="header-icon-btn" title="Account / Dashboard" aria-label="Account">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>

        <!-- Mobile Menu Trigger -->
        <button type="button" class="hamburger-btn" onclick="toggleMobileNav()" aria-label="Toggle Menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>

    </div>
  </header>

  <!-- 3. HERO SECTION (Editorial SHOP.CO Style) -->
  <section class="hero-section">
    <div class="container hero-grid">
      
      <!-- Left Column: Headline, Subtext, CTA, Statistics -->
      <div class="hero-content">
        <h1 class="hero-headline">FIND CLOTHES THAT MATCHES YOUR STYLE</h1>
        <p class="hero-subtext">
          Browse through our diverse selection of carefully curated garments, designed to bring out your individuality and cater to your sense of style.
        </p>
        <a href="#catalogSection" class="hero-cta-btn" onclick="scrollToCatalog()">Shop Now</a>

        <!-- 3 Horizontal Metrics -->
        <div class="hero-stats-row">
          <div class="hero-stat-item">
            <span class="hero-stat-number">200+</span>
            <span class="hero-stat-label">International Brands</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat-item">
            <span class="hero-stat-number">2,000+</span>
            <span class="hero-stat-label">High-Quality Products</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat-item">
            <span class="hero-stat-number">30,000+</span>
            <span class="hero-stat-label">Happy Customers</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Campaign Media & Sparkle Stars -->
      <div class="hero-media-wrapper">
        <!-- Floating Sparkle Stars from Reference -->
        <svg class="sparkle-star star-top-right" viewBox="0 0 100 100" fill="currentColor">
          <path d="M50 0 C50 27.6 72.4 50 100 50 C72.4 50 50 72.4 50 100 C50 72.4 27.6 50 0 50 C27.6 50 50 27.6 50 0 Z"/>
        </svg>
        <svg class="sparkle-star star-mid-left" viewBox="0 0 100 100" fill="currentColor">
          <path d="M50 0 C50 27.6 72.4 50 100 50 C72.4 50 50 72.4 50 100 C50 72.4 27.6 50 0 50 C27.6 50 50 27.6 50 0 Z"/>
        </svg>

        <img src="assets/images/hero_campaign.jpg" alt="Contemporary fashion campaign models" class="hero-campaign-img">
      </div>

    </div>
  </section>

  <!-- 4. LUXURY BRAND SHOWCASE BANNER -->
  <section class="brand-showcase-bar" aria-label="Featured Brands">
    <div class="brand-showcase-container">
      <span class="brand-item-title brand-versace">VERSACE</span>
      <span class="brand-item-title brand-zara">ZARA</span>
      <span class="brand-item-title brand-gucci">GUCCI</span>
      <span class="brand-item-title brand-prada">PRADA</span>
      <span class="brand-item-title brand-calvin">Calvin <strong>Klein</strong></span>
    </div>
  </section>

  <!-- 5. NEW ARRIVALS SECTION -->
  <section class="section-spacer" id="newArrivalsSection">
    <div class="container">
      <h2 class="section-heading-centered">NEW ARRIVALS</h2>
      <div class="products-grid" id="newArrivalsGrid">
        <!-- Product Cards rendered dynamically with Reference Image 2 layout -->
      </div>
      <div class="section-view-all-row">
        <button type="button" class="btn-view-all" onclick="filterByCategory(0)">View All</button>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- 6. TOP SELLING SECTION -->
  <section class="section-spacer" id="topSellingSection">
    <div class="container">
      <h2 class="section-heading-centered">TOP SELLING</h2>
      <div class="products-grid" id="topSellingGrid">
        <!-- Product Cards rendered dynamically with Reference Image 2 layout -->
      </div>
      <div class="section-view-all-row">
        <button type="button" class="btn-view-all" onclick="filterByCategory(0)">View All</button>
      </div>
    </div>
  </section>

  <!-- 7. BROWSE BY DRESS STYLE (Asymmetric Grid) -->
  <section class="section-spacer" id="dressStyleSection">
    <div class="container">
      <div class="dress-style-wrapper">
        <h2 class="section-heading-centered" style="margin-bottom:48px;">BROWSE BY DRESS STYLE</h2>
        
        <!-- Row 1: Casual (1fr) + Formal (1.6fr) -->
        <div class="dress-style-grid">
          <div class="dress-tile" onclick="filterByCategory(6)">
            <span class="dress-tile-title">Casual</span>
            <img src="assets/images/cat_casual.jpg" alt="Casual dress style" class="dress-tile-img" loading="lazy">
          </div>
          <div class="dress-tile" onclick="filterByCategory(7)">
            <span class="dress-tile-title">Formal</span>
            <img src="assets/images/cat_formal.jpg" alt="Formal dress style" class="dress-tile-img" loading="lazy">
          </div>
        </div>

        <!-- Row 2: Party (1.6fr) + Gym (1fr) -->
        <div class="dress-style-grid second-row">
          <div class="dress-tile" onclick="filterByCategory(7)">
            <span class="dress-tile-title">Party</span>
            <img src="assets/images/cat_party.jpg" alt="Party dress style" class="dress-tile-img" loading="lazy">
          </div>
          <div class="dress-tile" onclick="filterByCategory(8)">
            <span class="dress-tile-title">Gym</span>
            <img src="assets/images/cat_gym.jpg" alt="Gym sportswear style" class="dress-tile-img" loading="lazy">
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 8. SHOP CATALOG & FILTERS SECTION -->
  <section class="shop-catalog-section" id="catalogSection">
    <div class="container">
      
      <!-- Breadcrumbs -->
      <div class="shop-breadcrumbs">
        <a href="index.html">Home</a>
        <span>&rsaquo;</span>
        <span id="breadcrumbCategory">Shop</span>
        <span id="breadcrumbActiveTag"></span>
      </div>

      <!-- Shop Layout: Left Filter Sidebar + Right Products Grid -->
      <div class="shop-layout-grid">
        
        <!-- Filter Sidebar -->
        <aside class="filter-card" aria-label="Catalog Filters">
          <div class="filter-header-row">
            <h3 class="filter-header-title">Filters</h3>
            <button type="button" class="btn-filter-reset" onclick="resetAllFilters()">Reset All</button>
          </div>

          <!-- Category Filter Group -->
          <div class="filter-group-block">
            <div class="filter-group-title">Categories</div>
            <div class="filter-list">
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="0" checked onchange="filterByCategory(0)">
                  <span>All Products</span>
                </div>
                <span class="filter-count-badge" id="catCountAll">21</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="6" onchange="filterByCategory(6)">
                  <span>Casual Wear</span>
                </div>
                <span class="filter-count-badge">4</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="8" onchange="filterByCategory(8)">
                  <span>Outerwear & Coats</span>
                </div>
                <span class="filter-count-badge">1</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="7" onchange="filterByCategory(7)">
                  <span>Formal & Evening</span>
                </div>
                <span class="filter-count-badge">1</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="1" onchange="filterByCategory(1)">
                  <span>Tech Peripherals</span>
                </div>
                <span class="filter-count-badge">4</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="2" onchange="filterByCategory(2)">
                  <span>Audio & Wearables</span>
                </div>
                <span class="filter-count-badge">2</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="3" onchange="filterByCategory(3)">
                  <span>Textbooks & CS</span>
                </div>
                <span class="filter-count-badge">3</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="4" onchange="filterByCategory(4)">
                  <span>Hardware & DIY</span>
                </div>
                <span class="filter-count-badge">3</span>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="catRadio" value="5" onchange="filterByCategory(5)">
                  <span>Campus Stationery</span>
                </div>
                <span class="filter-count-badge">3</span>
              </label>
            </div>
          </div>

          <!-- Price Range Filter -->
          <div class="filter-group-block">
            <div class="filter-group-title">Price Range (₹)</div>
            <div class="price-inputs-row">
              <input type="number" id="minPriceInput" class="price-box-input" placeholder="Min ₹" min="0" step="50" onchange="applyFilters()">
              <span style="color:var(--text-light);">-</span>
              <input type="number" id="maxPriceInput" class="price-box-input" placeholder="Max ₹" min="0" step="100" onchange="applyFilters()">
            </div>
          </div>

          <!-- Availability Filter -->
          <div class="filter-group-block">
            <div class="filter-group-title">Availability</div>
            <label class="filter-item-label">
              <div class="filter-item-left">
                <input type="checkbox" id="inStockCheckbox" onchange="applyFilters()">
                <span>In Stock Only</span>
              </div>
            </label>
          </div>

          <!-- Rating Filter -->
          <div class="filter-group-block">
            <div class="filter-group-title">Customer Rating</div>
            <div class="filter-list">
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="ratingRadio" value="0" checked onchange="applyFilters()">
                  <span>All Ratings</span>
                </div>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="ratingRadio" value="4.5" onchange="applyFilters()">
                  <span>★ 4.5 & above</span>
                </div>
              </label>
              <label class="filter-item-label">
                <div class="filter-item-left">
                  <input type="radio" name="ratingRadio" value="4.0" onchange="applyFilters()">
                  <span>★ 4.0 & above</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Size Chips -->
          <div class="filter-group-block">
            <div class="filter-group-title">Size</div>
            <div class="size-chips-grid">
              <button type="button" class="size-chip-btn active" onclick="toggleSizeFilter(this, 'ALL')">All</button>
              <button type="button" class="size-chip-btn" onclick="toggleSizeFilter(this, 'XS')">XS</button>
              <button type="button" class="size-chip-btn" onclick="toggleSizeFilter(this, 'S')">S</button>
              <button type="button" class="size-chip-btn" onclick="toggleSizeFilter(this, 'M')">M</button>
              <button type="button" class="size-chip-btn" onclick="toggleSizeFilter(this, 'L')">L</button>
              <button type="button" class="size-chip-btn" onclick="toggleSizeFilter(this, 'XL')">XL</button>
            </div>
          </div>

          <button type="button" class="hero-cta-btn" style="width:100%; border-radius:var(--radius-sm); height:44px; padding:0; margin-top:10px;" onclick="applyFilters()">
            Apply Filters
          </button>
        </aside>

        <!-- Right Side: Catalog Toolbar & Products Grid -->
        <main class="catalog-content-area">
          <div class="catalog-top-bar">
            <div class="catalog-title-group">
              <h2 id="catalogCategoryTitle">All Products</h2>
              <div class="catalog-count-info">
                Showing <strong id="visibleCountText">0</strong> products
                <span id="activeFilterBadge" style="display:none; margin-left:8px; font-size:12px; background:var(--bg-input); padding:3px 10px; border-radius:999px;"></span>
              </div>
            </div>

            <div class="catalog-sort-group">
              <button type="button" class="btn-mobile-filter" onclick="toggleMobileFilters()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                <span>Filters</span>
              </button>

              <label for="sortSelect">Sort by:</label>
              <select id="sortSelect" class="sort-select-pill" onchange="handleSortChange(this.value)">
                <option value="featured">Most Popular</option>
                <option value="price_asc">Price: Low to High</option>
                <option value="price_desc">Price: High to Low</option>
                <option value="rating">Highest Rated</option>
              </select>
            </div>
          </div>

          <!-- The Main Products Grid -->
          <div class="products-grid" id="productsGrid" aria-live="polite">
            <!-- Dynamically populated with Reference Image 2 ProductCard layout -->
          </div>

          <!-- Empty State -->
          <div class="empty-catalog-state" id="emptyState" style="display:none;">
            <h4>No products found</h4>
            <p id="emptyStateMessage">We couldn't find any products matching your selected search or filter criteria.</p>
            <button type="button" class="btn-view-all" onclick="resetAllFilters()">Reset All Filters</button>
          </div>
        </main>

      </div>
    </div>
  </section>

  <!-- 9. CUSTOMER REVIEWS -->
  <section class="section-spacer" id="reviewsSection">
    <div class="container">
      <div class="reviews-section-header">
        <h2 class="section-heading-centered" style="margin-bottom:0; text-align:left;">OUR HAPPY CUSTOMERS</h2>
        <div class="reviews-nav-arrows">
          <button type="button" class="btn-review-nav" onclick="showToast('Browsing earlier verified reviews', 'info')" aria-label="Previous Reviews">&larr;</button>
          <button type="button" class="btn-review-nav" onclick="showToast('Browsing more verified customer reviews', 'info')" aria-label="Next Reviews">&rarr;</button>
        </div>
      </div>

      <div class="reviews-grid">
        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <div class="review-author-line">
            <span class="review-author-name">Sarah M.</span>
            <span class="verified-badge-icon" title="Verified Customer">✓</span>
          </div>
          <p class="review-text">
            "I'm blown away by the quality and fit of the clothes. Finding garments that look this elegant and feel so comfortable is rare. Delivery was super fast right to my door!"
          </p>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <div class="review-author-line">
            <span class="review-author-name">Alex K.</span>
            <span class="verified-badge-icon" title="Verified Customer">✓</span>
          </div>
          <p class="review-text">
            "Finding clothes that align with my personal aesthetic used to be a struggle until I discovered SHOP.CO. The Classic Casual T-shirt and Denim are staples in my wardrobe now."
          </p>
        </div>

        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <div class="review-author-line">
            <span class="review-author-name">James L.</span>
            <span class="verified-badge-icon" title="Verified Customer">✓</span>
          </div>
          <p class="review-text">
            "As someone who is particular about fabric weight and clean stitching, the Oversized Wool Coat exceeded all expectations. The entire ordering experience is effortless."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. FLOATING NEWSLETTER BANNER -->
  <div class="newsletter-banner-outer">
    <div class="newsletter-banner-box">
      <h2 class="newsletter-headline">STAY UP TO DATE ABOUT OUR LATEST OFFERS</h2>
      <form class="newsletter-form" onsubmit="event.preventDefault(); handleNewsletterSubscribe();">
        <div class="newsletter-input-wrap">
          <svg class="newsletter-mail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <input type="email" id="newsletterEmailInput" class="newsletter-input" placeholder="Enter your email address" required>
        </div>
        <button type="submit" class="newsletter-submit-btn">Subscribe to Newsletter</button>
      </form>
    </div>
  </div>

  <!-- 11. FOOTER -->
  <footer class="site-footer">
    <div class="container">
      
      <div class="footer-top-grid">
        <!-- Col 1: Brand & Social -->
        <div class="footer-brand-col">
          <span class="brand-text">SHOP.CO</span>
          <p class="footer-desc">
            We have clothes that suits your style and which you're proud to wear. From casual campus essentials to refined formal wear.
          </p>
          <div class="footer-social-row">
            <a href="https://twitter.com" target="_blank" rel="noopener" class="footer-social-link" aria-label="Twitter">
