  <!-- ==============================================================
       MODALS & DRAWERS
       ============================================================== -->

  <!-- PRODUCT DETAIL MODAL (Image 3 "Refined Edge" & SHOP.CO PDP Style) -->
  <div class="modal-overlay" id="productModal" onclick="if(event.target === this) closeProductModal();">
    <div class="modal-window pdp-modal-window">
      <button type="button" class="modal-close-corner" onclick="closeProductModal()" aria-label="Close">&times;</button>
      <div class="pdp-layout-grid" id="productModalBody">
        <!-- Dynamically rendered -->
      </div>
    </div>
  </div>

  <!-- SHOPPING CART DRAWER -->
  <div class="drawer-backdrop" id="cartOverlay" onclick="toggleCartDrawer(false)"></div>
  <aside class="cart-drawer-panel" id="cartDrawer" aria-label="Shopping Cart">
    <div class="drawer-header">
      <h3 class="drawer-title">YOUR CART (<span id="cartDrawerCount">0</span>)</h3>
      <button type="button" class="btn-drawer-close" onclick="toggleCartDrawer(false)">&times;</button>
    </div>

    <div class="drawer-body-items" id="cartDrawerBody">
      <!-- Items dynamically populated -->
    </div>

    <div class="drawer-footer-summary" id="cartDrawerFooter" style="display:none;">
      <div class="coupon-row">
        <input type="text" id="couponInput" class="coupon-input" placeholder="Add promo code (Try GUVI20)">
        <button type="button" class="btn-coupon-apply" onclick="applyCoupon()">Apply</button>
      </div>
      <div id="couponMessage" style="font-size:12px; display:none;"></div>

      <div class="summary-line">
        <span>Subtotal</span>
        <span id="cartSubtotalText">₹0.00</span>
      </div>
      <div class="summary-line" id="discountLine" style="display:none; color:var(--status-success);">
        <span>Discount (-20%)</span>
        <span id="cartDiscountText">-₹0.00</span>
      </div>
      <div class="summary-line">
        <span>Delivery Fee</span>
        <span id="cartShippingText" style="color:var(--status-success);">Free</span>
      </div>
      <div class="summary-line total">
        <span>Total</span>
        <span id="cartFinalTotalText">₹0.00</span>
      </div>

      <button type="button" class="btn-drawer-checkout" onclick="openCheckoutModal()">
        <span>Go to Checkout</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </div>
  </aside>

  <!-- WISHLIST DRAWER -->
  <div class="drawer-backdrop" id="wishlistOverlay" onclick="toggleWishlistDrawer(false)"></div>
  <aside class="cart-drawer-panel" id="wishlistDrawer" aria-label="Saved Wishlist">
    <div class="drawer-header">
      <h3 class="drawer-title">SAVED WISHLIST (<span id="wishlistDrawerCount">0</span>)</h3>
      <button type="button" class="btn-drawer-close" onclick="toggleWishlistDrawer(false)">&times;</button>
    </div>
    <div class="drawer-body-items" id="wishlistDrawerBody">
      <!-- Wishlist items dynamically populated -->
    </div>
  </aside>

  <!-- CHECKOUT MODAL -->
  <div class="modal-overlay" id="checkoutModal" onclick="if(event.target === this) closeCheckoutModal();">
    <div class="modal-window route-modal-box">
      <div class="route-header-strip">
        <h3>Order Checkout</h3>
        <button type="button" class="btn-drawer-close" onclick="closeCheckoutModal()">&times;</button>
      </div>
      <div class="route-modal-body">
        <form id="checkoutForm" onsubmit="event.preventDefault(); submitOrder();">
          <div class="checkout-form-grid">
            <div>
              <label class="form-field-label" for="shipName">Recipient Full Name *</label>
              <input type="text" id="shipName" class="form-field-input" required value="Rahul Sharma">
            </div>
            <div>
              <label class="form-field-label" for="shipPhone">10-Digit Mobile *</label>
              <input type="tel" id="shipPhone" class="form-field-input" required value="9876543220" pattern="[0-9]{10}">
            </div>
            <div class="form-group-full">
              <label class="form-field-label" for="shipAddress">Delivery Address *</label>
              <input type="text" id="shipAddress" class="form-field-input" required value="Room 204, Kaveri Hostel, IITM Campus">
            </div>
            <div>
              <label class="form-field-label" for="shipCity">City / Campus</label>
              <input type="text" id="shipCity" class="form-field-input" value="Chennai" readonly style="background:#e5e7eb;">
            </div>
            <div>
              <label class="form-field-label" for="shipPin">PIN Code *</label>
              <input type="text" id="shipPin" class="form-field-input" required value="600113" pattern="[0-9]{6}">
            </div>
            <div class="form-group-full">
              <label class="form-field-label" for="payMethod">Payment Method *</label>
              <select id="payMethod" class="form-field-select" required>
                <option value="COD">Cash on Campus Delivery (Pay at door)</option>
                <option value="UPI">Instant UPI (GPay / PhonePe / Paytm)</option>
                <option value="NET_BANKING">Net Banking (SBI / HDFC / ICICI)</option>
                <option value="CARD">Credit / Debit Card</option>
              </select>
            </div>
          </div>

          <div style="background:var(--bg-offwhite); border-radius:var(--radius-md); padding:16px; margin:20px 0;">
            <div style="display:flex; justify-content:space-between; font-size:14px; margin-bottom:6px;">
              <span>Total Payable Amount:</span>
              <strong id="checkoutFinalAmountText" style="font-size:16px;">₹0.00</strong>
            </div>
            <div style="font-size:12px; color:var(--text-muted);">
              Estimated Delivery: <strong>Today by 7:00 PM</strong> &bull; Free express delivery
            </div>
          </div>

          <div style="display:flex; gap:12px; justify-content:flex-end;">
            <button type="button" class="btn-view-all" onclick="closeCheckoutModal()">Back to Cart</button>
            <button type="submit" class="hero-cta-btn" id="btnPlaceOrder" style="border-radius:var(--radius-pill); padding:12px 32px;">Confirm & Place Order</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ORDER SUCCESS MODAL -->
  <div class="modal-overlay" id="orderSuccessModal">
    <div class="modal-window" style="max-width:500px; text-align:center; padding:40px 30px;">
      <div style="width:64px; height:64px; border-radius:50%; background:#e6f7ec; color:#059669; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h3 style="font-family:var(--font-heading); font-size:24px; font-weight:800; margin-bottom:10px;">Order Placed Successfully!</h3>
      <p style="font-size:14px; color:var(--text-muted); margin-bottom:20px; line-height:1.6;">
        Your order confirmation number is <strong id="successOrderNum" style="color:var(--text-main); font-family:var(--font-mono);"></strong>. An SMS confirmation has been dispatched.
      </p>
      <div style="display:flex; justify-content:center; gap:12px; flex-wrap:wrap;">
        <button type="button" class="hero-cta-btn" style="padding:12px 28px;" onclick="trackNewlyPlacedOrder()">Track Delivery Route</button>
        <button type="button" class="btn-view-all" onclick="closeOrderSuccessModal()">Continue Shopping</button>
      </div>
    </div>
  </div>

  <!-- DELIVERY ROUTE TRACKING MODAL -->
  <div class="modal-overlay" id="routeModal" onclick="if(event.target === this) closeRouteModal();">
    <div class="modal-window route-modal-box">
      <div class="route-header-strip">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
          Delivery Route & Order Tracking
        </h3>
        <button type="button" class="btn-drawer-close" onclick="closeRouteModal()">&times;</button>
      </div>

      <div class="route-modal-body">
        <div class="route-search-bar">
          <input type="text" id="routeSearchInput" placeholder="Enter Order # (e.g. ORD-2026-1004)">
          <button type="button" class="btn-track-action" onclick="lookupRouteOrder()">Track Route</button>
        </div>

        <div class="route-quick-chips" id="routeQuickChips"></div>

        <div class="route-status-card" id="routeInfoCard">
          <div class="route-card-top">
            <div>
              <span class="route-order-id" id="routeOrderNum">ORD-2026-1004</span>
              <span class="route-status-pill badge-status badge-out_for_delivery" id="routeStatusBadge">OUT_FOR_DELIVERY</span>
            </div>
            <div style="font-size:12px; font-weight:600; color:var(--text-muted);">
              Express Courier &bull; Van #8
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; font-size:13px; line-height:1.5;">
            <div>
              <div style="color:var(--text-muted); font-size:11px; text-transform:uppercase;">Destination Address:</div>
              <strong id="routeAddress">Room 204, Kaveri Hostel, IITM Campus</strong>
            </div>
            <div>
              <div style="color:var(--text-muted); font-size:11px; text-transform:uppercase;">Estimated Delivery:</div>
              <strong id="routeEstimatedTime" style="color:var(--status-success);">Today by 7:00 PM</strong>
            </div>
          </div>
        </div>

        <!-- 5-Stage Interactive Timeline -->
        <div class="route-timeline" id="routeTimeline"></div>

        <div id="routeItemsBox" style="margin-top:20px; background:var(--bg-input); padding:16px; border-radius:var(--radius-md);"></div>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer" aria-live="assertive"></div>

  <script src="app.js"></script>
</body>
