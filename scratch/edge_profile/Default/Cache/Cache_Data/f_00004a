/* ==============================================================
   SHOP.CO x GUVI Design System
   Modern, Premium Fashion E-Commerce Architecture
   Inspired by SHOP.CO & Reference Design Specs
   ============================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap');

:root {
  /* Color Palette - Minimalist Editorial Monochrome + Electric Accent */
  --bg-page: #ffffff;
  --bg-offwhite: #f2f0f1;
  --bg-card: #f0eeed;
  --bg-card-hover: #e8e6e5;
  --bg-dark: #000000;
  --bg-input: #f0f0f0;

  --text-main: #000000;
  --text-heading: #000000;
  --text-muted: #666666;
  --text-light: #999999;
  --text-inverse: #ffffff;

  /* Product Card Reference Specifications */
  --btn-cart-blue: #1769FF;
  --btn-cart-blue-hover: #0d57e0;
  --btn-cart-blue-active: #0947ba;
  --star-amber: #ffc633;
  --star-amber-dark: #f59e0b;
  --discount-green-bg: #e6f7ec;
  --discount-green-text: #059669;

  --status-success: #16a34a;
  --status-warning: #f59e0b;
  --status-danger: #ef4444;
  --status-info: #1769FF;

  /* Typography */
  --font-heading: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

  /* Spacing & Borders */
  --border-subtle: #e5e7eb;
  --border-dark: #000000;
  --radius-xs: 4px;
  --radius-sm: 7px; /* Exact reference card button radius */
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-pill: 9999px;

  /* Shadows */
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.04);
  --shadow-dropdown: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
  --shadow-modal: 0 25px 50px -12px rgba(0, 0, 0, 0.25);

  --transition-fast: all 0.18s ease;
  --transition-normal: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ==============================================================
   Base Reset
   ============================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-page);
  color: var(--text-main);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition-fast);
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  outline: none;
}

input, select, textarea {
  font-family: inherit;
  font-size: inherit;
  border: none;
  outline: none;
}

.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ==============================================================
   1. Announcement Bar
   ============================================================== */
.announcement-bar {
  background-color: var(--bg-dark);
  color: var(--text-inverse);
  font-size: 13px;
  padding: 9px 24px;
  position: relative;
  z-index: 100;
}

.announcement-container {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  text-align: center;
}

.announcement-text {
  font-weight: 400;
  letter-spacing: 0.1px;
}

.announcement-link {
  font-weight: 600;
  text-decoration: underline;
  margin-left: 4px;
  cursor: pointer;
  color: var(--text-inverse);
}
.announcement-link:hover {
  opacity: 0.85;
}

.announcement-tools {
  position: absolute;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16px;
}

.role-switcher-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.12);
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  color: #d1d5db;
}

.role-switcher-pill select {
  background: transparent;
  color: #ffffff;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
}
.role-switcher-pill select option {
  background: #111827;
  color: #ffffff;
}

.btn-announcement-close {
  color: #9ca3af;
  padding: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}
.btn-announcement-close:hover {
  color: #ffffff;
}

/* ==============================================================
   2. Navigation Header (SHOP.CO Style)
   ============================================================== */
.site-header {
  background-color: var(--bg-page);
  border-bottom: 1px solid var(--border-subtle);
  position: sticky;
  top: 0;
  z-index: 90;
  transition: box-shadow 0.25s ease;
}

.site-header.scrolled {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
}

.header-inner {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

/* Brand Logo */
.brand-logo {
  display: flex;
  align-items: baseline;
  text-decoration: none;
  flex-shrink: 0;
}

.brand-text {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 900;
  letter-spacing: -0.8px;
  color: var(--text-heading);
  text-transform: uppercase;
}

.brand-tag {
  font-size: 10px;
  font-weight: 700;
  background: var(--bg-dark);
  color: #ffffff;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: 6px;
  letter-spacing: 0.5px;
  align-self: center;
}

/* Desktop Navigation Links */
.desktop-nav {
  display: flex;
  align-items: center;
  gap: 24px;
  list-style: none;
}

.nav-link {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 0;
  position: relative;
  cursor: pointer;
}

.nav-link:hover {
  color: var(--text-muted);
}

.nav-link svg {
  transition: transform 0.2s ease;
}
.nav-link:hover svg {
  transform: translateY(1px);
}

/* Dropdown */
.nav-dropdown-wrapper {
  position: relative;
}

.nav-dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  background: #ffffff;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-dropdown);
  min-width: 220px;
  padding: 8px 0;
  display: none;
  z-index: 100;
  animation: fadeIn 0.2s ease;
}

.nav-dropdown-wrapper:hover .nav-dropdown-menu {
  display: block;
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 18px;
  font-size: 14px;
  color: var(--text-main);
  transition: var(--transition-fast);
}

.dropdown-item:hover {
  background: var(--bg-input);
  color: var(--btn-cart-blue);
}

/* Search Bar (Pill design) */
.header-search-bar {
  flex: 1;
  max-width: 540px;
  position: relative;
}

.search-input-pill {
  width: 100%;
  height: 48px;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  padding: 0 20px 0 48px;
  font-size: 14px;
  color: var(--text-main);
  transition: var(--transition-fast);
}

.search-input-pill::placeholder {
  color: var(--text-light);
}

.search-input-pill:focus {
  background-color: #ffffff;
  box-shadow: 0 0 0 2px var(--bg-dark);
}

.search-icon-svg {
  position: absolute;
  left: 18px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-light);
  pointer-events: none;
}

/* Header Actions Strip */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.header-icon-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--text-main);
  position: relative;
  transition: var(--transition-fast);
}

.header-icon-btn:hover {
  background-color: var(--bg-input);
}

.header-icon-badge {
  position: absolute;
  top: 4px;
  right: 4px;
  background-color: var(--btn-cart-blue);
  color: #ffffff;
  font-size: 10px;
  font-weight: 700;
  min-width: 18px;
  height: 18px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
}

.hamburger-btn {
  display: none;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  color: var(--text-main);
}

/* ==============================================================
   3. Hero Section (Editorial SHOP.CO Style)
   ============================================================== */
.hero-section {
  background-color: var(--bg-offwhite);
  padding: 60px 0 0 0;
  position: relative;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 40px;
}

.hero-content {
  padding-bottom: 60px;
}

.hero-headline {
  font-family: var(--font-heading);
  font-size: clamp(36px, 5.2vw, 64px);
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -1.2px;
  color: var(--text-heading);
  text-transform: uppercase;
  margin-bottom: 22px;
}

.hero-subtext {
  font-size: 16px;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 540px;
  margin-bottom: 34px;
}

.hero-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-dark);
  color: var(--text-inverse);
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  padding: 16px 54px;
  border-radius: var(--radius-pill);
  transition: transform 0.2s ease, background-color 0.2s ease;
  letter-spacing: 0.2px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
}

.hero-cta-btn:hover {
  background-color: #262626;
  transform: translateY(-2px);
}

/* Hero Statistics */
.hero-stats-row {
  display: flex;
  align-items: center;
  gap: 32px;
  margin-top: 48px;
  flex-wrap: wrap;
}

.hero-stat-item {
  display: flex;
  flex-direction: column;
}

.hero-stat-number {
  font-family: var(--font-heading);
  font-size: 38px;
  font-weight: 800;
  line-height: 1;
  color: var(--text-heading);
  letter-spacing: -0.5px;
}

.hero-stat-label {
  font-size: 14px;
  color: var(--text-muted);
  margin-top: 6px;
}

.hero-stat-divider {
  width: 1px;
  height: 48px;
  background-color: var(--border-subtle);
}

/* Hero Media Image Column */
.hero-media-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-self: end;
}

.hero-campaign-img {
  width: 100%;
  max-width: 520px;
  height: auto;
  object-fit: cover;
  display: block;
}

/* Decorative Sparkle Stars */
.sparkle-star {
  position: absolute;
  color: var(--bg-dark);
  pointer-events: none;
  animation: floatSparkle 4s ease-in-out infinite alternate;
}

.sparkle-star.star-top-right {
  top: 15%;
  right: 8%;
  width: 68px;
  height: 68px;
}

.sparkle-star.star-mid-left {
  top: 48%;
  left: 4%;
  width: 44px;
  height: 44px;
  animation-delay: 1.5s;
}

@keyframes floatSparkle {
  0% { transform: translateY(0px) rotate(0deg) scale(1); }
  100% { transform: translateY(-8px) rotate(6deg) scale(1.08); }
}

/* ==============================================================
   4. Brand Showcase Banner (Luxury Black Bar)
   ============================================================== */
.brand-showcase-bar {
  background-color: var(--bg-dark);
  padding: 38px 0;
  width: 100%;
}

.brand-showcase-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 32px;
}

.brand-item-title {
  color: #ffffff;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  transition: opacity 0.2s ease;
  user-select: none;
}

.brand-item-title:hover {
  opacity: 0.8;
}

.brand-versace {
  font-family: 'Times New Roman', serif;
  font-weight: 700;
  letter-spacing: 4px;
}

.brand-zara {
  font-family: var(--font-heading);
  font-weight: 900;
  letter-spacing: 1px;
}

.brand-gucci {
  font-family: 'Times New Roman', serif;
  font-weight: 600;
  letter-spacing: 5px;
}

.brand-prada {
  font-family: 'Georgia', serif;
  font-weight: 900;
  letter-spacing: 3px;
}

.brand-calvin {
  font-family: var(--font-body);
  font-weight: 300;
  letter-spacing: 2px;
  text-transform: none;
  font-size: 26px;
}
.brand-calvin strong {
  font-weight: 800;
}

/* ==============================================================
   5. Section Header & Spacing
   ============================================================== */
.section-spacer {
  padding: 72px 0;
}

.section-divider {
  max-width: 1240px;
  margin: 0 auto;
  height: 1px;
  background-color: var(--border-subtle);
}

.section-heading-centered {
  font-family: var(--font-heading);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 900;
  letter-spacing: -0.6px;
  text-align: center;
  text-transform: uppercase;
  color: var(--text-heading);
  margin-bottom: 48px;
}

.section-view-all-row {
  display: flex;
  justify-content: center;
  margin-top: 40px;
}

.btn-view-all {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border-subtle);
  background-color: #ffffff;
  color: var(--text-main);
  font-size: 15px;
  font-weight: 600;
  padding: 14px 56px;
  border-radius: var(--radius-pill);
  transition: var(--transition-fast);
}

.btn-view-all:hover {
  background-color: var(--bg-dark);
  color: #ffffff;
  border-color: var(--bg-dark);
}

/* ==============================================================
   6. PRODUCT CARD — STRICT REFERENCE IMAGE 2 REPRODUCTION
   Order:
   1. Product Image
   2. Product Name
   3. Star Rating and Review Count: ⭐ 4.4 (86)
   4. Current Price, MRP Original Price, Discount Badge
   5. Full-Width Blue Add to Cart Button with Shopping Cart Icon
   ============================================================== */
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.product-card {
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  transition: transform 0.22s ease;
  position: relative;
}

.product-card:hover {
  transform: translateY(-4px);
}

/* 1. Product Image Wrapper */
.card-thumb-wrapper {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  aspect-ratio: 1 / 1;
  width: 100%;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 16px;
}

.card-thumb-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.card-thumb-wrapper:hover .card-thumb-img {
  transform: scale(1.05);
}

/* Wishlist Icon Toggle */
.card-wishlist-btn {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 34px;
  height: 34px;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  transition: var(--transition-fast);
  z-index: 5;
}

.card-wishlist-btn:hover {
  color: #ef4444;
  background-color: #ffffff;
}

.card-wishlist-btn.active {
  color: #ef4444;
}

/* Stock tag */
.card-stock-pill {
  position: absolute;
  top: 12px;
  left: 12px;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-pill);
  text-transform: uppercase;
  letter-spacing: 0.4px;
  z-index: 5;
}
.card-stock-pill.low {
  background: #fef3c7;
  color: #b45309;
}
.card-stock-pill.out {
  background: #fee2e2;
  color: #b91c1c;
}

/* Card Information Block */
.card-info-block {
  padding-top: 14px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

/* 2. Product Name */
.card-product-name {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  color: var(--text-heading);
  line-height: 1.35;
  margin-bottom: 6px;
  cursor: pointer;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color 0.15s ease;
}

.card-product-name:hover {
  color: var(--btn-cart-blue);
}

/* 3. Product Rating and Review Count (Reference: ⭐ 4.4 (86)) */
.card-rating-row {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 8px;
  font-size: 13px;
}

.card-star-icon {
  color: var(--star-amber-dark);
  font-size: 15px;
  line-height: 1;
}

.card-rating-score {
  font-weight: 600;
  color: var(--star-amber-dark);
}

.card-review-count {
  color: var(--text-muted);
  font-weight: 400;
  font-size: 13px;
}

/* 4. Product Pricing: Current Price, MRP Strikethrough, Discount Badge */
.card-pricing-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.card-current-price {
  font-family: var(--font-heading);
  font-size: 19px;
  font-weight: 800;
  color: var(--text-heading);
  letter-spacing: -0.3px;
}

.card-mrp-price {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-light);
  text-decoration: line-through;
}

.card-discount-badge {
  background-color: var(--discount-green-bg);
  color: var(--discount-green-text);
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-pill);
  letter-spacing: 0.3px;
}

/* 5. ADD TO CART BUTTON — MATCHING REFERENCE IMAGE 2 */
.card-btn-add-cart {
  width: 100%;
  height: 42px;
  background-color: var(--btn-cart-blue);
  color: #ffffff;
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  border-radius: var(--radius-sm); /* ~7px rounded corners from reference */
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  box-shadow: 0 2px 4px rgba(23, 105, 255, 0.15);
  transition: var(--transition-fast);
  margin-top: auto;
}

.card-btn-add-cart:hover:not(:disabled) {
  background-color: var(--btn-cart-blue-hover);
  box-shadow: 0 4px 10px rgba(23, 105, 255, 0.28);
}

.card-btn-add-cart:active:not(:disabled) {
  background-color: var(--btn-cart-blue-active);
  transform: scale(0.98);
}

.card-btn-add-cart:disabled {
  background-color: #e2e8f0;
  color: #94a3b8;
  cursor: not-allowed;
  box-shadow: none;
}

.card-btn-add-cart svg {
  stroke-width: 2.2;
}

/* Added feedback animation */
.card-btn-add-cart.added {
  background-color: #059669;
}

/* ==============================================================
   7. Browse by Dress Style (SHOP.CO Asymmetric Category Tiles)
   ============================================================== */
.dress-style-wrapper {
  background-color: var(--bg-input);
  border-radius: 36px;
  padding: 64px 54px;
  max-width: 1240px;
  margin: 0 auto;
}

.dress-style-grid {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 20px;
}

.dress-style-grid.second-row {
  grid-template-columns: 1.6fr 1fr;
  margin-top: 20px;
}

.dress-tile {
  position: relative;
  height: 280px;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background-color: #ffffff;
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.dress-tile:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
}

.dress-tile-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.dress-tile:hover .dress-tile-img {
  transform: scale(1.06);
}

.dress-tile-title {
  position: absolute;
  top: 24px;
  left: 28px;
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 800;
  color: var(--text-heading);
  text-shadow: 0 1px 8px rgba(255, 255, 255, 0.8);
  z-index: 2;
}

/* ==============================================================
   8. Customer Reviews Section
   ============================================================== */
.reviews-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36px;
}

.reviews-nav-arrows {
  display: flex;
  gap: 12px;
}

.btn-review-nav {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-main);
  transition: var(--transition-fast);
}

.btn-review-nav:hover {
  background-color: var(--bg-dark);
  color: #ffffff;
  border-color: var(--bg-dark);
}

.reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.review-card {
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.review-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
}

.review-stars {
  color: var(--star-amber);
  display: flex;
  gap: 4px;
  font-size: 18px;
}

.review-author-line {
  display: flex;
  align-items: center;
  gap: 6px;
}

.review-author-name {
  font-family: var(--font-heading);
  font-size: 17px;
  font-weight: 700;
  color: var(--text-heading);
}

.verified-badge-icon {
  background-color: #059669;
  color: #ffffff;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
}

.review-text {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.6;
}

/* ==============================================================
   9. Floating Newsletter Banner
   ============================================================== */
.newsletter-banner-outer {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 10;
  margin-bottom: -90px;
}

.newsletter-banner-box {
  background-color: var(--bg-dark);
  border-radius: var(--radius-xl);
  padding: 44px 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}

.newsletter-headline {
  font-family: var(--font-heading);
  font-size: clamp(26px, 3.2vw, 38px);
  font-weight: 900;
  line-height: 1.15;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: -0.5px;
  max-width: 520px;
}

.newsletter-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 100%;
  max-width: 360px;
}

.newsletter-input-wrap {
  position: relative;
  width: 100%;
}

.newsletter-input {
  width: 100%;
  height: 48px;
  background-color: #ffffff;
  border-radius: var(--radius-pill);
  padding: 0 20px 0 46px;
  font-size: 14px;
  color: var(--text-main);
}

.newsletter-mail-icon {
  position: absolute;
  left: 18px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-light);
}

.newsletter-submit-btn {
  width: 100%;
  height: 48px;
  background-color: #ffffff;
  color: var(--bg-dark);
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  border-radius: var(--radius-pill);
  transition: opacity 0.2s ease;
}

.newsletter-submit-btn:hover {
  opacity: 0.9;
}

/* ==============================================================
   10. Footer
   ============================================================== */
.site-footer {
  background-color: var(--bg-offwhite);
  padding-top: 140px;
  padding-bottom: 50px;
  border-top: 1px solid var(--border-subtle);
}

.footer-top-grid {
  display: grid;
  grid-template-columns: 1.5fr repeat(4, 1fr);
  gap: 48px;
  padding-bottom: 50px;
  border-bottom: 1px solid var(--border-subtle);
}

.footer-brand-col {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.footer-desc {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 280px;
}

.footer-social-row {
  display: flex;
  gap: 12px;
}

.footer-social-link {
  width: 34px;
  height: 34px;
  background-color: #ffffff;
  border: 1px solid var(--border-subtle);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-main);
  transition: var(--transition-fast);
}

.footer-social-link:hover {
  background-color: var(--bg-dark);
  color: #ffffff;
  border-color: var(--bg-dark);
}

.footer-nav-col h5 {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--text-heading);
  margin-bottom: 22px;
}

.footer-nav-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.footer-nav-links a {
  font-size: 14px;
  color: var(--text-muted);
}

.footer-nav-links a:hover {
  color: var(--text-main);
  text-decoration: underline;
}

.footer-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 30px;
  flex-wrap: wrap;
  gap: 16px;
}

.footer-copyright {
  font-size: 13px;
  color: var(--text-muted);
}

.footer-payments {
  display: flex;
  align-items: center;
  gap: 10px;
}

.payment-badge {
  background: #ffffff;
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

/* ==============================================================
   11. Shop / Catalog Page Layout (Left Filters, Right Grid)
   ============================================================== */
.shop-catalog-section {
  padding: 40px 0 80px;
}

.shop-breadcrumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: var(--text-muted);
  margin-bottom: 28px;
}

.shop-breadcrumbs a:hover {
  color: var(--text-main);
}

.shop-layout-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 36px;
  align-items: start;
}

/* Filter Sidebar (Desktop) */
.filter-card {
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  padding: 24px;
  background-color: #ffffff;
  position: sticky;
  top: 100px;
}

.filter-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 20px;
}

.filter-header-title {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 800;
  color: var(--text-heading);
}

.btn-filter-reset {
  font-size: 13px;
  font-weight: 600;
  color: var(--btn-cart-blue);
  cursor: pointer;
}

.filter-group-block {
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 20px;
}

.filter-group-block:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.filter-group-title {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  color: var(--text-heading);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.filter-item-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: var(--text-muted);
  cursor: pointer;
  transition: var(--transition-fast);
}

.filter-item-label:hover {
  color: var(--text-main);
}

.filter-item-label input[type="radio"],
.filter-item-label input[type="checkbox"] {
  accent-color: var(--bg-dark);
  margin-right: 8px;
}

.filter-item-left {
  display: flex;
  align-items: center;
}

.filter-count-badge {
  font-size: 12px;
  color: var(--text-light);
}

/* Price Range Inputs */
.price-inputs-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.price-box-input {
  width: 100%;
  height: 40px;
  background-color: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 12px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-main);
}

/* Size Chips in Filter */
.size-chips-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.size-chip-btn {
  padding: 7px 16px;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
  transition: var(--transition-fast);
}

.size-chip-btn:hover {
  background-color: #e5e7eb;
}

.size-chip-btn.active {
  background-color: var(--bg-dark);
  color: #ffffff;
  font-weight: 600;
}

/* Catalog Area Header & Sort */
.catalog-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  flex-wrap: wrap;
  gap: 16px;
}

.catalog-title-group h2 {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 900;
  color: var(--text-heading);
}

.catalog-count-info {
  font-size: 14px;
  color: var(--text-muted);
  margin-top: 4px;
}

.catalog-sort-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.catalog-sort-group label {
  font-size: 14px;
  color: var(--text-muted);
}

.sort-select-pill {
  height: 40px;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  padding: 0 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
  cursor: pointer;
}

/* Mobile Filter Trigger */
.btn-mobile-filter {
  display: none;
  align-items: center;
  gap: 8px;
  height: 40px;
  padding: 0 16px;
  background: var(--bg-input);
  border-radius: var(--radius-pill);
  font-size: 14px;
  font-weight: 600;
}

/* Empty State */
.empty-catalog-state {
  text-align: center;
  padding: 80px 20px;
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  margin: 20px 0;
}

.empty-catalog-state h4 {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 8px;
}

.empty-catalog-state p {
  font-size: 14px;
  color: var(--text-muted);
  max-width: 400px;
  margin: 0 auto 20px;
}

/* ==============================================================
   12. Product Detail Page / Modal (Reference Image 3 & SHOP.CO PDP)
   ============================================================== */
.modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(5px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.modal-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-window {
  background-color: #ffffff;
  border-radius: var(--radius-xl);
  max-width: 960px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-modal);
  position: relative;
  transform: translateY(20px);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-overlay.open .modal-window {
  transform: translateY(0);
}

.modal-close-corner {
  position: absolute;
  top: 18px;
  right: 20px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: var(--text-main);
  z-index: 10;
  transition: var(--transition-fast);
}
.modal-close-corner:hover {
  background: var(--bg-dark);
  color: #ffffff;
}

/* PDP Layout */
.pdp-layout-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 36px;
  padding: 36px;
}

.pdp-gallery-column {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.pdp-main-image-box {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 24px;
}

.pdp-main-image-box img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.pdp-thumbnails-row {
  display: flex;
  gap: 12px;
}

.pdp-thumb-item {
  width: 72px;
  height: 72px;
  background-color: var(--bg-card);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: var(--transition-fast);
}

.pdp-thumb-item.active {
  border-color: var(--bg-dark);
}

.pdp-info-column {
  display: flex;
  flex-direction: column;
}

.pdp-category-tag {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.8px;
  margin-bottom: 6px;
}

.pdp-title {
  font-family: var(--font-heading);
  font-size: 26px;
  font-weight: 900;
  line-height: 1.25;
  color: var(--text-heading);
  margin-bottom: 12px;
}

.pdp-rating-row {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  margin-bottom: 16px;
}

.pdp-pricing-row {
  display: flex;
  align-items: baseline;
  gap: 14px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 18px;
}

.pdp-price-current {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 900;
  color: var(--text-heading);
}

.pdp-price-mrp {
  font-size: 18px;
  font-weight: 500;
  color: var(--text-light);
  text-decoration: line-through;
}

.pdp-desc {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 22px;
}

/* PDP Option Selectors */
.pdp-option-section {
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 18px;
}

.pdp-option-heading {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 10px;
}

.pdp-colors-row {
  display: flex;
  gap: 12px;
}

.pdp-color-circle {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  cursor: pointer;
  position: relative;
  transition: transform 0.15s ease;
  border: 1px solid rgba(0, 0, 0, 0.1);
}

.pdp-color-circle.active {
  box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px var(--bg-dark);
}

.pdp-sizes-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.pdp-size-btn {
  padding: 9px 20px;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-main);
  transition: var(--transition-fast);
}

.pdp-size-btn:hover {
  background-color: #e5e7eb;
}

.pdp-size-btn.active {
  background-color: var(--bg-dark);
  color: #ffffff;
  font-weight: 700;
}

/* PDP Actions: Qty + Cart Button */
.pdp-actions-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 10px;
}

.pdp-qty-stepper {
  display: flex;
  align-items: center;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  height: 48px;
  padding: 0 8px;
}

.pdp-qty-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  color: var(--text-main);
}

.pdp-qty-val {
  min-width: 36px;
  text-align: center;
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
}

.pdp-btn-add {
  flex: 1;
  height: 48px;
  background-color: var(--btn-cart-blue);
  color: #ffffff;
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: var(--transition-fast);
  box-shadow: 0 4px 12px rgba(23, 105, 255, 0.25);
}

.pdp-btn-add:hover {
  background-color: var(--btn-cart-blue-hover);
}

/* Accordions */
.pdp-accordion-box {
  margin-top: 22px;
  border-top: 1px solid var(--border-subtle);
}

.accordion-item {
  border-bottom: 1px solid var(--border-subtle);
}

.accordion-header {
  padding: 14px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
}

.accordion-content {
  padding-bottom: 14px;
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.6;
  display: none;
}

.accordion-item.open .accordion-content {
  display: block;
}

/* ==============================================================
   13. Shopping Cart Drawer
   ============================================================== */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.drawer-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

.cart-drawer-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 440px;
  background-color: #ffffff;
  z-index: 1010;
  display: flex;
  flex-direction: column;
  box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.cart-drawer-panel.open {
  transform: translateX(0);
}

.drawer-header {
  padding: 22px 24px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.drawer-title {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 800;
}

.btn-drawer-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: var(--text-main);
  background-color: var(--bg-input);
}

.drawer-body-items {
  flex: 1;
  overflow-y: auto;
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Cart Item Card */
.cart-item-card {
  display: flex;
  gap: 14px;
  padding: 14px;
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  position: relative;
}

.cart-item-thumb {
  width: 72px;
  height: 72px;
  background-color: #ffffff;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  flex-shrink: 0;
}

.cart-item-thumb img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.cart-item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-item-title {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text-heading);
  padding-right: 24px;
}

.cart-item-variant {
  font-size: 12px;
  color: var(--text-muted);
}

.cart-item-price-qty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
}

.cart-item-price {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 800;
}

.cart-qty-controls {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border-subtle);
  height: 30px;
  padding: 0 4px;
}

.cart-qty-btn {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
}

.cart-qty-num {
  min-width: 24px;
  text-align: center;
  font-size: 13px;
  font-weight: 700;
}

.btn-remove-item {
  position: absolute;
  top: 14px;
  right: 14px;
  color: #ef4444;
  cursor: pointer;
  transition: opacity 0.2s;
}

/* Drawer Footer */
.drawer-footer-summary {
  padding: 20px 24px;
  border-top: 1px solid var(--border-subtle);
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.coupon-row {
  display: flex;
  gap: 8px;
}

.coupon-input {
  flex: 1;
  height: 42px;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  padding: 0 16px;
  font-size: 13px;
}

.btn-coupon-apply {
  background-color: var(--bg-dark);
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  padding: 0 20px;
  border-radius: var(--radius-pill);
}

.summary-line {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: var(--text-muted);
}

.summary-line.total {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 800;
  color: var(--text-heading);
  border-top: 1px solid var(--border-subtle);
  padding-top: 10px;
}

.btn-drawer-checkout {
  height: 48px;
  background-color: var(--bg-dark);
  color: #ffffff;
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: var(--transition-fast);
}

.btn-drawer-checkout:hover {
  background-color: #262626;
}

/* ==============================================================
   14. Delivery Route Tracking & Orders Modal
   ============================================================== */
.route-modal-box {
  max-width: 680px;
}

.route-header-strip {
  padding: 24px 28px 16px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.route-header-strip h3 {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 10px;
}

.route-modal-body {
  padding: 24px 28px;
}

.route-search-bar {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.route-search-bar input {
  flex: 1;
  height: 44px;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  padding: 0 18px;
  font-size: 14px;
  font-weight: 600;
}

.btn-track-action {
  background-color: var(--bg-dark);
  color: #ffffff;
  font-weight: 700;
  padding: 0 24px;
  border-radius: var(--radius-pill);
}

.route-quick-chips {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.route-chip-btn {
  padding: 6px 14px;
  background-color: var(--bg-input);
  border-radius: var(--radius-pill);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition-fast);
}
.route-chip-btn:hover {
  background-color: var(--bg-dark);
  color: #ffffff;
}

.route-status-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 18px 22px;
  margin-bottom: 24px;
}

.route-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.route-order-id {
  font-family: var(--font-mono);
  font-size: 17px;
  font-weight: 800;
}

.route-status-pill {
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

/* Timeline */
.route-timeline {
  display: flex;
  justify-content: space-between;
  position: relative;
  margin: 32px 0 24px;
}

.route-timeline::before {
  content: '';
  position: absolute;
  top: 15px;
  left: 20px;
  right: 20px;
  height: 2px;
  background-color: var(--border-subtle);
  z-index: 1;
}

.route-step-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
  text-align: center;
  width: 80px;
}

.route-node-icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: #ffffff;
  border: 2px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-light);
  margin-bottom: 8px;
  transition: var(--transition-fast);
}

.route-step-node.completed .route-node-icon {
  background-color: var(--status-success);
  border-color: var(--status-success);
  color: #ffffff;
}

.route-step-node.active .route-node-icon {
  background-color: var(--btn-cart-blue);
  border-color: var(--btn-cart-blue);
  color: #ffffff;
  box-shadow: 0 0 0 4px rgba(23, 105, 255, 0.2);
}

.route-step-title {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
}

.route-step-time {
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 3px;
}

/* ==============================================================
   15. Toast Notifications
   ============================================================== */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.toast {
  pointer-events: auto;
  background-color: var(--bg-dark);
  color: #ffffff;
  padding: 14px 22px;
  border-radius: var(--radius-md);
  font-size: 14px;
  font-weight: 500;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  gap: 10px;
  animation: slideToast 0.25s ease;
}

.toast.success {
  border-left: 4px solid var(--status-success);
}
.toast.error {
  border-left: 4px solid var(--status-danger);
}
.toast.info {
  border-left: 4px solid var(--btn-cart-blue);
}

@keyframes slideToast {
  from { transform: translateX(30px); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==============================================================
   16. Checkout Modal & Forms
   ============================================================== */
.checkout-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.form-group-full {
  grid-column: span 2;
}

.form-field-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-heading);
  margin-bottom: 6px;
}

.form-field-input, .form-field-select {
  width: 100%;
  height: 44px;
  background-color: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 0 14px;
  font-size: 14px;
  color: var(--text-main);
  border: 1px solid transparent;
  transition: var(--transition-fast);
}

.form-field-input:focus, .form-field-select:focus {
  background-color: #ffffff;
  border-color: var(--bg-dark);
}

/* ==============================================================
   17. Dashboards (Buyer, Seller, Admin)
   ============================================================== */
.dashboard-container {
  max-width: 1280px;
  margin: 32px auto 80px;
  padding: 0 24px;
}

.dashboard-nav-tabs {
  display: flex;
  gap: 8px;
  background: var(--bg-input);
  padding: 4px;
  border-radius: var(--radius-pill);
  width: fit-content;
  margin-bottom: 32px;
}

.dash-tab-btn {
  padding: 10px 24px;
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  border-radius: var(--radius-pill);
  color: var(--text-muted);
  transition: var(--transition-fast);
}

.dash-tab-btn.active {
  background-color: #ffffff;
  color: var(--text-heading);
  box-shadow: var(--shadow-sm);
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}

.metric-stat-box {
  background-color: #ffffff;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 24px;
}

.metric-stat-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.metric-stat-value {
  font-family: var(--font-heading);
  font-size: 32px;
  font-weight: 900;
  color: var(--text-heading);
  margin: 8px 0 4px;
}

.metric-stat-sub {
  font-size: 12px;
  color: var(--text-light);
}

/* Modern Data Tables */
.dash-table-card {
  background-color: #ffffff;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 32px;
}

.dash-table-header {
  padding: 20px 24px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dash-table-title {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 800;
}

.dash-data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.dash-data-table th {
  background-color: var(--bg-offwhite);
  padding: 12px 20px;
  text-align: left;
  font-weight: 700;
  color: var(--text-muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.dash-data-table td {
  padding: 14px 20px;
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text-main);
}

.dash-data-table tr:last-child td {
  border-bottom: none;
}

/* Status Badges */
.badge-status {
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.3px;
  display: inline-block;
}
.badge-status.badge-delivered, .badge-status.badge-active {
  background-color: #e6f7ec;
  color: #059669;
}
.badge-status.badge-shipped, .badge-status.badge-confirmed {
  background-color: #eff6ff;
  color: #2563eb;
}
.badge-status.badge-out_for_delivery {
  background-color: #fef3c7;
  color: #d97706;
}
.badge-status.badge-cancelled, .badge-status.badge-suspended {
  background-color: #fee2e2;
  color: #dc2626;
}

/* ==============================================================
   18. Mobile & Responsive Media Queries
   ============================================================== */
@media (max-width: 1024px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero-subtext {
    margin: 0 auto 30px;
  }
  .hero-stats-row {
    justify-content: center;
  }
  .hero-media-wrapper {
    margin-top: 20px;
  }
  .shop-layout-grid {
    grid-template-columns: 1fr;
  }
  .filter-card {
    display: none;
  }
  .btn-mobile-filter {
    display: inline-flex;
  }
  .pdp-layout-grid {
    grid-template-columns: 1fr;
  }
  .footer-top-grid {
    grid-template-columns: 1fr 1fr;
  }
  .metrics-row {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .desktop-nav, .header-search-bar {
    display: none;
  }
  .hamburger-btn {
    display: flex;
  }
  .announcement-bar {
    font-size: 11px;
    padding: 8px 16px;
  }
  .announcement-tools {
    display: none;
  }
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .hero-headline {
    font-size: 36px;
  }
  .hero-stat-number {
    font-size: 28px;
  }
  .brand-showcase-container {
    justify-content: center;
    gap: 24px;
  }
  .brand-item-title {
    font-size: 20px;
  }
  .dress-style-wrapper {
    padding: 32px 20px;
    border-radius: 20px;
  }
  .dress-style-grid, .dress-style-grid.second-row {
    grid-template-columns: 1fr;
  }
  .dress-tile {
    height: 200px;
  }
  .reviews-grid {
    grid-template-columns: 1fr;
  }
  .newsletter-banner-box {
    flex-direction: column;
    padding: 32px 24px;
    text-align: center;
  }
  .newsletter-headline {
    text-align: center;
  }
  .footer-top-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .footer-bottom-row {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 480px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
  .hero-stats-row {
    flex-direction: column;
    gap: 16px;
  }
  .hero-stat-divider {
    display: none;
  }
  .metrics-row {
    grid-template-columns: 1fr;
  }
}

/* ==============================================================
   18. Add Product Modal (Seller Inventory Portal)
   ============================================================== */
.add-product-modal-window {
  max-width: 740px;
  width: 100%;
  border-radius: var(--radius-xl);
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  max-height: 92vh;
  box-shadow: var(--shadow-modal);
  position: relative;
  overflow: hidden;
}

.modal-header-strip {
  padding: 24px 28px 18px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  background-color: #ffffff;
}

.modal-body-content {
  padding: 24px 28px;
  overflow-y: auto;
  flex: 1;
}

.form-section-card {
  background-color: #fafafa;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 20px;
}

.form-section-title {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--text-heading);
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-subtle);
}

.required-star {
  color: var(--status-error);
  font-weight: 700;
}

.field-error-msg {
  display: block;
  font-size: 12px;
  color: var(--status-error);
  margin-top: 5px;
  font-weight: 600;
  min-height: 16px;
}

.form-error-alert {
  padding: 12px 18px;
  background-color: #fff1f2;
  border: 1px solid #fecdd3;
  border-radius: var(--radius-sm);
  color: #be123c;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 18px;
  line-height: 1.45;
  display: flex;
  align-items: center;
  gap: 10px;
}

.add-prod-img-preview-box {
  width: 96px;
  height: 96px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
  overflow: hidden;
  background: var(--bg-input);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-prod-img-preview-box img {
  width: 100%;
  height: 72px;
  object-fit: cover;
}

.variant-sizes-pill-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.size-checkbox-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-pill);
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  background-color: #ffffff;
  transition: var(--transition-fast);
  user-select: none;
}

.size-checkbox-pill:hover {
  border-color: var(--bg-dark);
}

.size-checkbox-pill input[type="checkbox"] {
  accent-color: var(--bg-dark);
  cursor: pointer;
}

.modal-footer-actions {
  padding: 18px 28px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
  background-color: #ffffff;
}

.spinner-inline {
  display: inline-block;
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: #ffffff;
  animation: spin 0.6s linear infinite;
  vertical-align: middle;
  margin-right: 6px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 640px) {
  .add-product-modal-window {
    max-height: 96vh;
    border-radius: var(--radius-lg);
  }
  .modal-header-strip, .modal-body-content, .modal-footer-actions {
    padding: 16px 18px;
  }
  .checkout-form-grid {
    grid-template-columns: 1fr;
  }
  .checkout-form-grid > div {
    grid-column: span 1 !important;
  }
}
